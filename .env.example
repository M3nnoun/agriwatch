# --- Database ---
# Default: SQLite (no Docker, zero setup). Resolves to prisma/dev.db.
DATABASE_URL="file:./dev.db"
# For PostgreSQL + PostGIS (used by docker compose) instead use:
# DATABASE_URL="postgresql://agriwatch:agriwatch_dev@localhost:5432/agriwatch"

# --- Required for live Claude alerts in /simulate ---
ANTHROPIC_API_KEY="sk-ant-..."

# Optional — demo mode works without these
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
COPERNICUS_CLIENT_ID="..."
COPERNICUS_CLIENT_SECRET="..."

# Demo mode — set true for hackathon
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"
